# ---------------------------------------------------------------------------
# FraudShield AI - environment template
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Django core ---
# Generate a fresh key for production:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Absolute base URL used inside emailed links (verification, reports) ---
# The part before the path, e.g. "http://127.0.0.1:8000". Django uses this so a
# link opened on another device (a phone) actually reaches your app instead of
# the unreachable "127.0.0.1" of the machine that sent it. When set, it is used
# verbatim and the incoming Host header is ignored (a forged Host cannot poison
# a link). Leave empty only for single-machine development.
#   Local, same machine only : SITE_URL=http://127.0.0.1:8000
#   Test from your phone      : SITE_URL=http://<your-LAN-IP>:8000
#                               (run "ipconfig" / "ifconfig" for the IPv4 addr,
#                                and start with: python manage.py runserver 0:8000)
#   Production                : SITE_URL=https://your-domain.example
SITE_URL=

# --- Database ---
# Leave USE_POSTGRES unset (or False) to use local SQLite.
# Set USE_POSTGRES=True (and the DB_* values) for PostgreSQL in production.
USE_POSTGRES=False
POSTGRES_DB=fraudshield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
# Render (and many PaaS) provide a single connection string instead of the
# granular POSTGRES_* values. When DATABASE_URL is set it takes priority and is
# parsed by dj-database-url; leave it empty for local development.
#   DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=
# Render recommends not pooling connections through its proxy:
DB_CONN_MAX_AGE=0
# Set True only when connecting to an external Render DB from outside (needs SSL).
DB_SSL_REQUIRE=False

# --- Production security (only used when DJANGO_DEBUG=False) ---
# In production you MUST also set DJANGO_SECRET_KEY (there is no fallback when
# DEBUG=False) and DJANGO_DEBUG=False. List every real host, e.g. Render's
# assigned domain and any custom domain.
#   DJANGO_DEBUG=False
#   DJANGO_SECRET_KEY=<a fresh random secret, never committed>
#   DJANGO_ALLOWED_HOSTS=your-app.onrender.com,www.yourdomain.example
# CSRF_TRUSTED_ORIGINS needs the FULL origin (https://...). It is auto-derived
# from SITE_URL below, but you can list extra origins here (comma-separated).
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Optional URL reputation lookup (Phase 3) ---
# OFF by default. When enabled, FraudShield sends ONLY the URL string to Google's
# Safe Browsing Lookup API for a verdict. It never visits/downloads the URL.
URL_REPUTATION_ENABLED=False
GOOGLE_SAFE_BROWSING_KEY=

# --- Email delivery (verification + report emailing + alerts/summaries) ---
# Dev/test default is the console / locmem backend so no SMTP is required.
# For production, uncomment and set these:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your SMTP username
# EMAIL_HOST_PASSWORD=your SMTP password (never commit a real value)
# DEFAULT_FROM_EMAIL=FraudShield AI <alerts@example.com>
# Lifetime of a verification LINK before it expires (NOT a wait between sends).
EMAIL_VERIFICATION_TTL_HOURS=24

# --- Gmail SMTP quick setup (placeholders only - fill real values in .env) ---
# Requires a Google Account with 2-Step Verification and a 16-character
# App Password (Google Account -> Security -> App passwords).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=FraudShield AI <your-email@gmail.com>

# --- Report email rate limiting ---
# Minimum seconds between successful "Send Report to Registered Email" actions.
REPORT_EMAIL_COOLDOWN_SECONDS=60

# --- Verification-email resend rate limiting (abuse protection) ---
# These bound how often a single account can request a NEW verification email.
# They do NOT change the link's 24h lifetime and never disable verification.
# Minimum seconds between verification-email sends to the same account.
VERIFICATION_EMAIL_COOLDOWN_SECONDS=60
# Maximum verification-email sends allowed per rolling hour per account.
VERIFICATION_EMAIL_HOURLY_LIMIT=5
